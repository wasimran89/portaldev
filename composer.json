{
    "name": "drupal/legacy-project",
    "description": "Project template for Drupal 9 projects with composer following drupal/drupal layout",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "chillerlan/php-qrcode": "^4.3",
        "christian-riesen/otp": "^2.7",
        "composer/installers": "^1.9",
        "defuse/php-encryption": "^2.3",
        "doctrine/common": "^3.2",
        "drupal/admin_toolbar": "^3.1",
        "drupal/backup_migrate": "^5.0",
        "drupal/captcha": "^1.10",
        "drupal/color_field": "^3.0",
        "drupal/commerce": "^2.29",
        "drupal/commerce_agree_terms": "^1.0",
        "drupal/commerce_authnet": "^1.6",
        "drupal/commerce_cart_api": "^1.8",
        "drupal/commerce_decoupled_checkout": "^1.5",
        "drupal/commerce_fedex": "^1.0@RC",
        "drupal/commerce_order_update": "^2.0",
        "drupal/commerce_shipping": "^2.3",
        "drupal/commerce_ups": "^4.0",
        "drupal/core-composer-scaffold": "9.5.7",
        "drupal/core-project-message": "9.5.7",
        "drupal/core-recommended": "9.5.7",
        "drupal/core-vendor-hardening": "^9.2",
        "drupal/ctools": "^3.7",
        "drupal/devel": "^5.1",
        "drupal/devel_php": "^1.5",
        "drupal/domain": "^1.0@beta",
        "drupal/drupalmoduleupgrader": "^1.7",
        "drupal/edit_in_place_field": "^2.0@beta",
        "drupal/email_registration": "^1.2",
        "drupal/encrypt": "^3.0",
        "drupal/eu_cookie_compliance": "^1.24",
        "drupal/flood_control": "^2.3",
        "drupal/ga_login": "^1.0@alpha",
        "drupal/group": "^1.4",
        "drupal/image_base64_formatter": "^2.0",
        "drupal/inline_entity_form": "^1.0-rc6",
        "drupal/key": "^1.14",
        "drupal/lang_dropdown": "^2.0",
        "drupal/languageicons": "^2.0@beta",
        "drupal/login_destination": "^2.0@beta",
        "drupal/login_history": "^2.0",
        "drupal/masquerade": "^2.0@RC",
        "drupal/menu_per_role": "^1.5",
        "drupal/real_aes": "^2.5",
        "drupal/redirect_after_logout": "^1.2",
        "drupal/restui": "^1.21",
        "drupal/services": "^4.0@beta",
        "drupal/site_branding_per_role": "^1.0",
        "drupal/smtp": "^1.0",
        "drupal/swiftmailer": "^2.4",
        "drupal/tfa": "^1.0@alpha",
        "drupal/upgrade_status": "^4.3",
        "drupal/views_bulk_operations": "^4.0",
        "drupal/views_database_connector": "^1.4",
        "drupal/webform": "^6.0",
        "drupal/webform_entity_handler": "^2.0@beta",
        "drupal/webform_rest": "^4.1",
        "drupal/webform_views": "^5.0@alpha",
        "drush/drush": "^11.6",
        "league/csv": "^9.18",
        "phpoffice/phpspreadsheet": "^1.24"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true
        }
    },
    "extra": {

        "enable-patching": true,
        "patches": {
            "commerce": {
                "commerce-order-admin-template-display-custom-fields": "https://www.drupal.org/files/issues/2018-11-02/commerce-order-admin-template-display-custom-fields-2915559-5.patch"
            }
        },

        "drupal-scaffold": {
            "locations": {
                "web-root": "./"
            }
        },
        "installer-paths": {
            "core": [
                "type:drupal-core"
            ],
            "libraries/{$name}": [
                "type:drupal-library"
            ],
            "modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/legacy-project template!               </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}

         if (in_array('administrator', $roles)) {
           $querypartner = $conn->query("select partner_id, partner_name from partner order by partner_name");
           $resultspart = $querypartner->fetchAll();
           foreach ($resultspart as $keypart => $valuepart) {
             //$resultpartner[$valuepart->partner_id] = $valuepart->partner_name;
             $resultpartner[] = $valuepart->partner_id;
           }
           mapRelatedPartnerswithGrouptypeforsimprofile($resultpartner, $group_ids);
           $form["elements"]["step_1_profile_name"]["partner_name"]["#options"] = $group_ids;

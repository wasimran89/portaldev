      $querypartner = $conn->query("select id, label from groups_field_data");
      $resultspart = $querypartner->fetchAll();
      foreach ($resultspart as $keypart => $valuepart) {
        $partner_name[$valuepart->id] = $valuepart->label;
      }


      if ($options && $partner_name) {
        // Get the existing options.
        //$predefined_options = $options->getOptions();

        $options->setOptions($partner_name);
        
        // Save the updated options list.
        $options->save();

        \Drupal::logger('jcius_custom')->notice('Updated options for partner_name: ' . print_r($partner_name, TRUE));
      }
      else {
        \Drupal::logger('jcius_custom')->error('Could not load Webform options for partner_name.');
      }
   }

   //Email validation

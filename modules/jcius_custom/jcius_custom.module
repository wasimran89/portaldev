function jcius_custom_views_pre_view($view, $display_id, array &$args) {
   $user_roles = \Drupal::currentUser()->getRoles();
   if ($view->id() == 'user_management') {
      if (in_array('administrator', $user_roles)) {
         // Remove the contextual filter for admin role.
       $view->removeHandler($display_id, 'argument', 'field_group_type_target_id');
       $view->removeHandler($display_id, 'filter', 'roles_target_id'); //adminstrator
      }
   }

   if ($view->id() == 'transaction_history_logs') {
      if (in_array('administrator', $user_roles)) {
         // Remove the contextual filter for admin role.
       //$view->removeHandler($display_id, 'argument', 'uid');
       //$view->removeHandler($display_id, 'filter', 'state'); //draft
      }
   }
}

function jcius_custom_entity_access(\Drupal\Core\Entity\EntityInterface $entity, $operation, \Drupal\Core\Session\AccountInterface $account) {
  $user_roles = \Drupal::currentUser()->getRoles();
     if (
       (in_array('tenant_management', $user_roles)
       || in_array('esim_admin', $user_roles)
       || in_array('usim_admin', $user_roles))
       && !in_array('administrator', $user_roles)
   ) {
     // Check if the entity is an order and the operation is 'view'.
     if ($entity->getEntityTypeId() == 'commerce_order' && $operation == 'view') {  
       // Get the customer user ID from the order.
       if ($entity->hasField('uid') && !$entity->get('uid')->isEmpty()) {
         // Load the user entity associated with the order.
         $order_user = $entity->get('uid')->entity;

         // Load the current user entity (who is trying to view the order).
         $current_user = \Drupal\user\Entity\User::load($account->id());

         // Check if both the current user and the order user have the 'field_group_type'.
         if ($current_user && !$current_user->isAnonymous() && $current_user->hasField('field_group_type') && 
             $order_user && $order_user->hasField('field_group_type')) {
           
           // Get the 'field_group_type' from both the current user and the order user.
           $current_user_group = $current_user->get('field_group_type')->target_id;
           $order_user_group = $order_user->get('field_group_type')->target_id;
           // Check if the group types match.
           if ($current_user_group === $order_user_group) {
             return \Drupal\Core\Access\AccessResult::allowed();
           } 
           else {
             return \Drupal\Core\Access\AccessResult::forbidden();
           }
         }
       }
     }
  }
  // For all other cases, return neutral.
  //return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Custom validation callback for phone number.
 */
function jcius_custom_validate_phone_number(array &$form, FormStateInterface $form_state) {
   $order = \Drupal::routeMatch()->getParameter('commerce_order');
   if ($order instanceof OrderInterface) {
      $phone_number = jcius_custom_get_shipping_address($order);
      if(!$phone_number){
         $phone_number = $form_state->getValue(['shipping_information', 'shipping_profile','field_phone_number', 0, 'value']);
      }
      //\Drupal::logger('jcius_custom')->notice(print_r($phone_number, TRUE));
   }

  //$phone_number = $form_state->getValue(['shipping_information', 'shipping_profile','field_phone_number', 0, 'value']);

   if ($phone_number) {
      // Check if the phone number matches the required format.
      if (!preg_match('/^\+?[1-9]\d{5,14}$/', $phone_number)) {
        $form_state->setErrorByName('shipping_information][address][0][field_phone_number', t('The phone number must be a valid phone number. You entered: @phone', ['@phone' => $phone_number]));
      }
   } else {
      $form_state->setErrorByName('shipping_information][address][0][field_phone_number', t('The phone number field is missing. Please add a phone number by clicking the "Edit" button in the Shipping Information tab. You entered: @phone', ['@phone' => $phone_number]));
   }
}

function jcius_custom_get_shipping_address(OrderInterface $order) {
  // Get the shipping profile from the order.
  //$shipping_profile = $order->get('shipments')->entity->get('shipping_profile')->entity;
  $shipments = $order->get('shipments');
   if ($shipments && $shipments->entity) {
       $shipping_profile_entity = $shipments->entity->get('shipping_profile')->entity;
       if ($shipping_profile_entity) {
           $shipping_profile = $shipping_profile_entity;
       } else {
           $shipping_profile = null;
       }
   } else {
       $shipping_profile = null;
   }

  if ($shipping_profile instanceof Profile) {
      $phone = $shipping_profile->get('field_phone_number')->value;
      return $phone;
  } else {
      return null;
  }  
}

function jcius_custom_user_update($account) {
   $conn = \Drupal\Core\Database\Database::getConnection('default', 'third');
   $user = \Drupal\user\Entity\User::load($account->id());
   $username = $user->get('mail')->getString();
   $name = $user->get('name')->getString();
   $group_type = $user->get('field_group_type')->target_id;
   $groups = Group::loadMultiple();
   $sim_partner_id = 0;
   foreach ($groups as $group) {
      $id = $group->id();            
      if ($group_type == $id) {
          $label = trim($group->label());
          $queryp = $conn->select('partner', 'p')
                      ->fields('p', ['partner_id'])
                      ->condition('p.partner_name', $label);
          $resultp = $queryp->execute()->fetchAll();
          //if ($resultp[0]->partner_id) {
          if (!empty($resultp) && isset($resultp[0]->partner_id)) {
            $sim_partner_id = $resultp[0]->partner_id;
            break;
          } else {
            $sim_partner_id = 0;
          }          
      }
   }

   // Connect to the external database
   try {    
    $query = $conn->query("update drupal_user set name='".$name."', sim_partner_id=" . $sim_partner_id . " where drupal_user='".$username."'");
   } catch (Exception $e) {
      \Drupal::logger('jcius_custom')->notice('Failed to update external DB: @message' . print_r($e->getMessage(), TRUE));
   }
}

function jcius_custom_user_insert($account) {
   $conn = \Drupal\Core\Database\Database::getConnection('default', 'third');
   $user = \Drupal\user\Entity\User::load($account->id());
   $username = $user->get('mail')->getString();
   $name = $user->get('name')->getString();
   $group_type = $user->get('field_group_type')->target_id;
   $groups = Group::loadMultiple();
   $sim_partner_id = 0;
   foreach ($groups as $group) {
      $id = $group->id();            
      if ($group_type == $id) {
          $label = trim($group->label());
          $queryp = $conn->select('partner', 'p')
                      ->fields('p', ['partner_id'])
                      ->condition('p.partner_name', $label);
          $resultp = $queryp->execute()->fetchAll();
          //if ($resultp[0]->partner_id) {
          if (!empty($resultp) && isset($resultp[0]->partner_id)) {
            $sim_partner_id = $resultp[0]->partner_id;
            break;
          } else {
            $sim_partner_id = 0;
          }          
      }
   }

   // Connect to the external database
   try {
      $query = $conn->select('drupal_user', 'u');
      $query->fields('u');
      $query->condition('u.drupal_user', $username);
      $results = $query->execute()->fetchAll();
      if(!$results) {
         $query2 = $conn->query("insert into drupal_user(drupal_user,name,sim_partner_id) values ('".$username."','".$name."',".$sim_partner_id.")");
      } else {
         \Drupal::logger('jcius_custom')->notice('Username already exist : ' . $username);
      }
   } catch (Exception $e) {
      \Drupal::logger('jcius_custom')->notice('Failed to insert external DB: @message' . print_r($e->getMessage(), TRUE));
   }
}

function jcius_custom_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() == '10t_usage_log') { // Change 'my_view_id' to your View's ID$query->where
    $current_time = time();
    foreach ($query->where as &$where_group) {
      foreach ($where_group['conditions'] as &$condition) {
         // 1 Day
         if ($condition['field'] == '10t_usage.timestamp BETWEEN 0 AND 86400') {
           $last_24_hours = $current_time - (24 * 60 * 60); 
           // Convert user input (YYYY-MM-DD) into UNIX timestamp
           $condition['field'] = '10t_usage.timestamp BETWEEN '.$last_24_hours.' AND '.$current_time;
         }
         //1 Week
         if ($condition['field'] == '10t_usage.timestamp BETWEEN 0 AND 604800') {
           $last_7_days = $current_time - (7 * 24 * 60 * 60); 
           $condition['field'] = '10t_usage.timestamp BETWEEN '.$last_7_days.' AND '.$current_time;
         }
         //1 Month
         if ($condition['field'] == '10t_usage.timestamp BETWEEN 0 AND 2592000') {
           $last_30_days = $current_time - (30 * 24 * 60 * 60);
           $condition['field'] = '10t_usage.timestamp BETWEEN '.$last_30_days.' AND '.$current_time;
         }
         //6 Months
         if ($condition['field'] == '10t_usage.timestamp BETWEEN 0 AND 15552000') {
           $last_180_days = $current_time - (180 * 24 * 60 * 60);
           $condition['field'] = '10t_usage.timestamp BETWEEN '.$last_180_days.' AND '.$current_time;
         }
         //1 Year
         if ($condition['field'] == '10t_usage.timestamp BETWEEN 0 AND 31536000') {
           $last_365_days = $current_time - (365 * 24 * 60 * 60);
           $condition['field'] = '10t_usage.timestamp BETWEEN '.$last_365_days.' AND '.$current_time;
         }
         //2 Years
         if ($condition['field'] == '10t_usage.timestamp BETWEEN 0 AND 63072000') {
           $last_730_days = $current_time - (730 * 24 * 60 * 60);
           $condition['field'] = '10t_usage.timestamp BETWEEN '.$last_730_days.' AND '.$current_time;
         }
      }
    }
  }
}

/**
 * Implements hook_entity_update().
 */
function jcius_custom_entity_update(\Drupal\Core\Entity\EntityInterface $entity) {
  // Check if the entity is a Group.
  if ($entity->getEntityTypeId() === 'group') {

    // Get current group ID.
    $group_id = $entity->id();

    // Fetch tier-type values from the Group.
    $field_esim_tier_type = $entity->get('field_esim_tier_type')->target_id ?? NULL;
    $field_plastic_sim_tier_type = $entity->get('field_plastic_sim_tier_type')->target_id ?? NULL;
    $field_overlay_sim_tier_type = $entity->get('field_overlay_sim_tier_type')->target_id ?? NULL;
    $field_esim_reset_tier_type = $entity->get('field_esim_reset_tier_type')->target_id ?? NULL;
    $field_esim_release_tier_type = $entity->get('field_esim_release_tier_type')->target_id ?? NULL;

    // Load all users having the same group assigned in field_group_type.
    $user_storage = \Drupal::entityTypeManager()->getStorage('user');
    $user_ids = $user_storage->getQuery()
      ->condition('field_group_type', $group_id)
      ->condition('status', 1) // Optional: only active users
      ->execute();

    if (!empty($user_ids)) {
      $users = $user_storage->loadMultiple($user_ids);

      foreach ($users as $user) {
        // Update tier-type fields to match the group.
        $user->set('field_esim_tier_type', $field_esim_tier_type);
        $user->set('field_3_slot_tier_type', $field_plastic_sim_tier_type);
        $user->set('field_overlay_sim_tier_type', $field_overlay_sim_tier_type);
        $user->set('field_esim_reset_tier_type', $field_esim_reset_tier_type);
        $user->set('field_esim_release_tier_type', $field_esim_release_tier_type);
        $user->save();
      }

      \Drupal::logger('jcius_custom')->info(
        'Updated @count users for group ID @gid.',
        ['@count' => count($user_ids), '@gid' => $group_id]
      );
    }
  }
}

/**
 * Implements hook_entity_presave().
 */
function jcius_custom_entity_presave(\Drupal\Core\Entity\EntityInterface $entity) {
  // Only run for user entities.
  if ($entity->getEntityTypeId() === 'user') {
    $cgid = $entity->get('field_group_type')->target_id ?? NULL;
    if ($cgid) {
      $group = Group::load($cgid);
      if ($group) {
        \Drupal::logger('jcius_custom')->info("Syncing user fields from group @gid", ['@gid' => $cgid]);

        // Copy fields from group to user.
        $entity->set('field_esim_tier_type', $group->get('field_esim_tier_type')->target_id ?? NULL);
        $entity->set('field_3_slot_tier_type', $group->get('field_plastic_sim_tier_type')->target_id ?? NULL);
        $entity->set('field_overlay_sim_tier_type', $group->get('field_overlay_sim_tier_type')->target_id ?? NULL);
        $entity->set('field_esim_reset_tier_type', $group->get('field_esim_reset_tier_type')->target_id ?? NULL);
        $entity->set('field_esim_release_tier_type', $group->get('field_esim_release_tier_type')->target_id ?? NULL);
      }
    }
  }
}
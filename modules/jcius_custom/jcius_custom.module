      ],
   ];
}

function jcius_custom_webform_submission_delete($submission) {
   // Get an array of the values from the submission.
   if ($submission) {
      $values = $submission->getData();
      $simprofilename = $values['sim_profile_name'];
      //$grouptype = $values['group_type'];
      $grouptype = $values['partner_name'];
      $product = \Drupal\commerce_product\Entity\Product::load('7');
      /*Load Product Variations*/
      $entity_manager = \Drupal::entityTypeManager();
      $variations = $product->getVariations();

      foreach ($variations as $variation) {
         $productgrouptype = $variation->get('field_group_id')->value;
         $title = $variation->getTitle();
         if (($grouptype == $productgrouptype) && ($simprofilename == $title)) {
            $variation_id = $variation->get('variation_id')->value;
            $product_variation = \Drupal\commerce_product\Entity\ProductVariation::load($variation_id);
            $product->removeVariation($product_variation);
            $product->save();
            \Drupal::messenger()->addStatus(t('Variation deleted!'));
            //for attribute delete
            $table = 'commerce_product_attribute_value_field_data';
            $database = \Drupal::database();
            $query = $database->query("DELETE FROM `{$table}` WHERE `name`= '{$title}'");
            $result = $query->execute();
            \Drupal::messenger()->addStatus(t('Product attributed deleted!!!'));
            $table2 = 'commerce_product_variation_field_data';
            $query2 = $database->query("DELETE FROM `{$table2}` WHERE `title`= '{$title}'");
            $result2 = $query2->execute();
            \Drupal::messenger()->addStatus(t('Product variation field deleted!!!'));
         }
      }

      $userStorage = \Drupal::entityTypeManager()->getStorage('user');
      $query = $userStorage->getQuery();
      $current_user = \Drupal::currentUser();
      $uid = $current_user->id();
      $table = 'commerce_order';
      $table2 = 'commerce_order_item';
      $database = \Drupal::database();
      $query = $database->query("SELECT * FROM {$table} where uid in ({$uid}) and state='completed'");
      $result = $query->fetchAll();
      $results = [];
      foreach ($result as $key => $value) {
         //flag=1 deleted record
         $query2 = $database->query("UPDATE `{$table2}` SET `flag` = '1' WHERE `order_id` = '{$value->order_id}' and `title` = '{$simprofilename}'");
         $result2 = $query2->execute();
         if ($result2) {
            \Drupal::messenger()->addStatus(t('Flag updated!!!'));
         }
      }
   } //submision of webform
}

function jcius_custom_commerce_product_variation_presave(Drupal\Core\Entity\EntityInterface $entity) {
   //SIM profile product variation plublish change webform profile status approve and vice versa
   // Check if the entity type is commerce_product_variation.
   if ($entity->getEntityTypeId() === 'commerce_product_variation') {
    // Get the product entity.
    $product = $entity->getProduct();
    // Check if the product type is 'product_type_machine_name'.
    if ($product && $product->bundle() === 'sim_profile') {
      $title = $entity->getTitle();
      $group_id = $entity->get('field_group_id')->value;
      $connection = Database::getConnection();

      $query = $connection->select('webform_submission_data', 'wsd1');
      $query->distinct()
           ->fields('wsd1', ['sid'])
           ->condition('wsd1.name', 'sim_profile_name')
           ->condition('wsd1.value', $title);

      $query->join('webform_submission_data', 'wsd2', 'wsd1.sid = wsd2.sid');
      //$query->condition('wsd2.name', 'group_type');
      $query->condition('wsd2.name', 'partner_name');
      $query->condition('wsd2.value', $group_id);

      $results = $query->execute()->fetchAll();

      // Check if the product variation is published.
      if ($entity->status->value == 1) {    
         if ($results) {
            $query2 = $connection->update('webform_submission_data');
            $query2->fields(['value' => 'Approved']);
            $query2->condition('sid', $results[0]->sid);
            $query2->condition('name', 'profile_status');
            $query2->execute();
            //hide for now
            //\Drupal::messenger()->addMessage($title.' SIM profile has been approved.');
         } else {
            \Drupal::messenger()->addWarning('No matching record found for webform submission data: '.$title);
         }
      } else {
         if ($results) {
            $query2 = $connection->update('webform_submission_data');
            $query2->fields(['value' => 'Pending']);
            $query2->condition('sid', $results[0]->sid);
            $query2->condition('name', 'profile_status');
            $query2->execute();
            \Drupal::messenger()->addMessage($title.' SIM profile has been pending.');
         } else {
            \Drupal::messenger()->addWarning('No matching record found for webform submission data: '.$title);
         }
      }
    }
  }
}

function jcius_custom_emtpy_cart_when_partner_changed() {
   //Cart Start
   $cart_provider = \Drupal::service('commerce_cart.cart_provider');
   // Get all carts for the current user.
   $carts = $cart_provider->getCarts($user);
   $cart_is_empty = true; // Assume the cart is empty initially.

   if (!empty($carts)) {
       foreach ($carts as $cart) {
           // Check if the cart has any order items.
           $items = $cart->getItems(); // Get items as an array.
           if (!empty($items)) {
               $cart_is_empty = false; // The cart is not empty.
               break;
           }
       }
   }

   if ($cart_is_empty) {
       //\Drupal::messenger()->addMessage('The cart is empty.');
   } else {
      //\Drupal::messenger()->addMessage('The cart contains items.');
      foreach ($carts as $cart) {
        $cart_items = $cart->getItems();
        foreach ($cart_items as $item) {
          // Get the purchased entity (product variation) from the cart item.
          $product_variation = $item->getPurchasedEntity();

          // Ensure the purchased entity exists and the field is available.
          if ($product_variation && $product_variation->hasField('field_group_id')) {
              // Safely retrieve the value of the 'field_group_id' field.
              $group_type_id = $product_variation->get('field_group_id')->value;
           }
          if (isset($group_type_id) && $_GET['group_id'] != $group_type_id) {
            $cart->removeItem($item);
            \Drupal::messenger()->addWarning(t('Your previous cart is getting overridden because the partner name has been changed.'));
          }
        }

        // Save the cart after removing items.
        $cart->save();
      }
   }
   //Cart End
}

/**
 * Implements hook_form_FORM_ID_alter() for the product add to cart form.
 */
function jcius_custom_form_commerce_order_item_add_to_cart_form_alter(&$form, FormStateInterface $form_state, $form_id) {
 //16, 17 are credit product so not included others are here
 if($form_id != 'commerce_order_item_add_to_cart_form_commerce_product_16' && $form_id != 'commerce_order_item_add_to_cart_form_commerce_product_17') {
   //IMSI Range
   $imsiresult = [];
   $session = \Drupal::request()->getSession();
   $conn = \Drupal\Core\Database\Database::getConnection('default', 'third');
   $user = \Drupal\user\Entity\User::load(\Drupal::currentUser()->id());  
   $roles = $user->getRoles();  

   if (in_array('administrator', $roles)) {
      if (!empty($_GET['group_id'])) {
         $groups = \Drupal\group\Entity\Group::loadMultiple();
         $group_id = $_GET['group_id'];
         $group_label = '';

         // Mapping in group list in Drupal application
         foreach ($groups as $group) {
           if ($group->id() == $group_id) {
               $group_label = trim($group->label());
               break;
           }
         }

         // Fetch partner_id if a group label is matched
         if (!empty($group_label)) {
           $cqueryp = $conn->query("SELECT partner_id FROM {partner} WHERE partner_name = :group_label", [':group_label' => $group_label]);
           $cresultp = $cqueryp->fetchAll();

           if (!empty($cresultp)) {
               $partner_id = $cresultp[0]->partner_id;
           }
         }
         // Fetch IMSI range names associated with the resolved partner_id
         $queryimsi = $conn->select('imsi_range', 'i');
         $queryimsi->fields('i', ['imsi_range_name']);
         $queryimsi->condition('partner_id', $partner_id);      
      } else {
         $queryimsi = $conn->select('imsi_range', 'i');
         $queryimsi->fields('i', ['imsi_range_name']);
      }
   } else {
      $partner_id = $session->get('current_partner_id');

      // Check if group_id is provided and not empty, then override the partner_id
      if (!empty($_GET['group_id'])) {
          $groups = \Drupal\group\Entity\Group::loadMultiple();
          $group_id = $_GET['group_id'];
          $group_label = '';

          // Mapping in group list in Drupal application
          foreach ($groups as $group) {
              if ($group->id() == $group_id) {
                  $group_label = trim($group->label());
                  break;
              }
          }

          // Fetch partner_id if a group label is matched
          if (!empty($group_label)) {
              $cqueryp = $conn->query("SELECT partner_id FROM {partner} WHERE partner_name = :group_label", [':group_label' => $group_label]);
              $cresultp = $cqueryp->fetchAll();

              if (!empty($cresultp)) {
                  $partner_id = $cresultp[0]->partner_id;
              }
          }
      }

      // Fetch IMSI range names associated with the resolved partner_id

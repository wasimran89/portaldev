      $paymentType = $user->get('field_payment_type')->getValue();
      $type = $group[0]['target_id'];

      $session = \Drupal::request()->getSession();
      $conn = \Drupal\Core\Database\Database::getConnection('default', 'third');

      //parent child start
      if ($session->get('current_partner_id')) {
         $all_related_partners = [];
         fetchRelatedPartners($session->get('current_partner_id'), $all_related_partners);
         $all_related_partners[] = $session->get('current_partner_id');
         $partners_list = implode(',', array_map('intval', $all_related_partners));      

         // Build the query dynamically
         $querypid = $conn->query("
         SELECT partner_id, partner_name 
         FROM partner 

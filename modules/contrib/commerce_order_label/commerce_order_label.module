<?php

/**
 * @file
 * Commerce order label module.
 */

use Drupal\Core\Entity\EntityTypeInterface;

/**
 * Implements hook_entity_type_build().
 *
 * @param EntityTypeInterface[] $entity_types
 */
function commerce_order_label_entity_type_build(array &$entity_types) {
  if (isset($entity_types['commerce_order'])) {
    $entity_types['commerce_order']->setClass('Drupal\commerce_order_label\Entity\Order');
  }
}

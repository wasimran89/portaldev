<?php

/**
 * Implements hook_schema().
 */
function usage_10t_schema() {
  $schema['10t_usage'] = [
    'description' => 'Table to store 10T activity logs.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary Key: Unique log ID.',
      ],
      'iccid' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The ICCID associated with the activity.',
      ],
      'path' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'Path of the activity.',
      ],
      'activity' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Description of the activity.',
      ],
      'uid' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'User ID of the activity initiator.',
      ],
      'timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Timestamp of the activity.',
      ],
    ],
    'primary key' => ['id'],
  ];
  return $schema;
}